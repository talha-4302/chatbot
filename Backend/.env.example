# Copy to .env. With the placeholder key the service runs in MOCK mode.
LLM_API_KEY=your-api-key-here
# Gemini model ID (https://ai.google.dev/gemini-api/docs/models)
LLM_MODEL=gemini-3.5-flash-lite
# Cap on OUTPUT tokens per reply (Gemini 2.5 thinking tokens count against this).
LLM_MAX_TOKENS=2048
PORT=3000
